#!/usr/bin/env bash
# tracker — fixed entry point for the news-tracker skills.
# Skills call this by path so the agent never picks a Python interpreter or
# redirects into .env itself (both trip Hermes's command scanner).
#
#   bash "$TRACKER" watchlist add "<topic>" [--queries "a,b"] | remove "<topic>" | list | run-one "<topic>" | run-all | delta "<topic>"
#   bash "$TRACKER" briefing generate [--weekly] [--since YYYY-MM-DD] | show [--date YYYY-MM-DD]
#   bash "$TRACKER" brief-data [--weekly]                        # the briefing, compacted for the agent: id, title, source, url, engagement, 200-char snippet
#   bash "$TRACKER" research "<topic>" [last30days flags]
#   bash "$TRACKER" track "<topic>" ["query one,query two"]    # start (or resume) watching a topic; history kept
#   bash "$TRACKER" drop "<topic>"                              # stop watching a topic; history and dismissals kept
#   bash "$TRACKER" retune "<topic>" "query one,query two"     # re-point a topic at what the user reacted to
#   bash "$TRACKER" dismiss <finding_id> [<finding_id> ...]     # hide findings the user rejected
#   bash "$TRACKER" history "<words>" [limit]                   # everything ever stored that matches: first seen, times seen, dismissed?
#   bash "$TRACKER" ingest "<topic>" <file.json>                 # add findings the agent fetched itself (e.g. X via Composio) to the store
#   bash "$TRACKER" podcast-link <episode_slug> [start_seconds] [podcast_slug] [episode_title]  # the citable link for a Particle episode (YouTube w/ timestamp if it has one, else the publisher's episode url)
#   bash "$TRACKER" set-key <particle_api_key>                  # store the Particle key in this profile's .env
#   bash "$TRACKER" check-key                                   # verify the stored Particle key against the API
#   bash "$TRACKER" sync-header                                 # copy the stored Particle key into the MCP header (no key in chat)
#   bash "$TRACKER" header-state                                # is the MCP header a literal key, the placeholder, or missing?
#   bash "$TRACKER" set-x-bearer <x_api_bearer_token>            # DIRECT X: store an X API v2 app-only bearer token (this profile's .env)
#   bash "$TRACKER" check-x-bearer                              # verify it with one tiny recent-search call
#   bash "$TRACKER" x-pull "<topic>" [max_results] [hours]       # DIRECT X: recent search for a topic (+ its retune queries), ingest into the store
#   bash "$TRACKER" set-x-key <xai_api_key>                     # store an xAI key for X/Twitter coverage (engine config)
#   bash "$TRACKER" check-x-key                                 # verify the stored xAI key
#   bash "$TRACKER" onboarding status|next                      # the onboarding checklist and what to pick up next
#   bash "$TRACKER" onboarding done|skip|later <task> [days]    # mark a task done, declined, or snoozed
#   bash "$TRACKER" timezone <IANA zone>                        # e.g. America/New_York; routines fire at 08:00 in this zone
#   bash "$TRACKER" config-set <dotted.key> <value>             # write one config.yaml key (true/false/number/string)
#   bash "$TRACKER" reset [--keys]                              # back to day zero: topics, findings, checklist gone, routines paused; --keys also forgets Particle/xAI keys
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="$(cd "$HERE/../../.." && pwd)"          # <profile>/skills/news-tracker/bin -> <profile>
L30D="$HERE/../../research/last30days/scripts"
ENV_FILE="$PROFILE/.env"
[ -f "$L30D/watchlist.py" ] || { echo "tracker: last30days scripts not found at $L30D"; exit 1; }

# Python: the research engine hard-requires 3.12+. Look on PATH, then in uv's
# managed interpreters (uv ships with Hermes; install.sh installs 3.12 through it
# when nothing suitable exists), so nobody has to be asked to "update Python".
py_ok() { "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; }
PY=""
for c in python3.14 python3.13 python3.12 python3; do
  if command -v "$c" >/dev/null 2>&1 && py_ok "$c"; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  for uv in "$HOME/.hermes/bin/uv" "$(command -v uv 2>/dev/null)" /usr/local/bin/uv; do
    if [ -n "$uv" ] && [ -x "$uv" ]; then
      cand="$("$uv" python find '>=3.12' 2>/dev/null || true)"
      if [ -n "$cand" ] && py_ok "$cand"; then PY="$cand"; break; fi
    fi
  done
fi
[ -n "$PY" ] || { echo "tracker: no Python 3.12+ found on PATH or via uv. Run the pack installer again; it installs one with uv."; exit 1; }

read_x_bearer() {
  if [ -n "${X_BEARER_TOKEN:-}" ]; then printf '%s' "$X_BEARER_TOKEN"; return; fi
  [ -f "$ENV_FILE" ] || return 0
  sed -n 's/^X_BEARER_TOKEN=//p' "$ENV_FILE" | tail -1 | tr -d '"'"'"' '
}

read_key() {
  if [ -n "${PARTICLE_API_KEY:-}" ]; then printf '%s' "$PARTICLE_API_KEY"; return; fi
  [ -f "$ENV_FILE" ] || return 0
  sed -n 's/^PARTICLE_API_KEY=//p' "$ENV_FILE" | tail -1 | tr -d '"'"'"' '
}

sub="${1:-}"; shift || true
case "$sub" in
  watchlist) "$PY" "$L30D/watchlist.py" "$@" ;;
  briefing)  "$PY" "$L30D/briefing.py" "$@" ;;

  brief-data)
    tmp="$(mktemp "${TMPDIR:-/tmp}/brief.XXXXXX.json")"
    "$PY" "$L30D/briefing.py" generate "$@" > "$tmp" || { echo '{"error": "briefing generate failed"}'; rm -f "$tmp"; exit 1; }
    "$PY" - "$tmp" <<'PYEOF'
import json, sys, re
d = json.load(open(sys.argv[1]))
out = {"date": d.get("date"), "since": d.get("since"), "topics": []}
for t in d.get("topics", []):
    items = []
    for f in t.get("findings", []) or []:
        text = re.sub(r"\s+", " ", (f.get("content") or f.get("summary") or "")).strip()
        items.append({
            "id": f.get("id"), "title": (f.get("source_title") or "")[:140], "source": f.get("source"),
            "url": f.get("source_url"), "author": f.get("author") or None,
            "engagement": round(float(f.get("engagement_score") or 0)),
            "first_seen": (f.get("first_seen") or "")[:10], "times_seen": f.get("sighting_count"),
            "snippet": text[:200],
        })
    items.sort(key=lambda x: -x["engagement"])
    out["topics"].append({"name": t.get("name"), "new": t.get("new_count", len(items)), "last_status": t.get("last_status"), "findings": items[:25]})
print(json.dumps(out, ensure_ascii=False))
PYEOF
    rm -f "$tmp"
    ;;

  research)  "$PY" "$L30D/last30days.py" "$@" ;;

  track)
    topic="${1:-}"; queries="${2:-}"
    [ -n "$topic" ] || { echo "usage: tracker track \"<topic>\" [\"query one,query two\"]"; exit 2; }
    ( cd "$L30D" && "$PY" - "$topic" "$queries" <<'PYEOF'
import sys, json, store
topic, raw = sys.argv[1], sys.argv[2]
queries = [q.strip() for q in raw.split(",") if q.strip()] or None
t = store.get_topic(topic)
if not t:
    store.add_topic(topic, search_queries=queries, schedule="0 8 * * *")
    print(json.dumps({"action": "added", "topic": topic, "queries": queries})); sys.exit(0)
conn = store._connect()
try:
    if queries:
        conn.execute("UPDATE topics SET enabled = 1, search_queries = ?, updated_at = datetime('now') WHERE id = ?", (json.dumps(queries), t["id"]))
    else:
        conn.execute("UPDATE topics SET enabled = 1, updated_at = datetime('now') WHERE id = ?", (t["id"],))
    conn.commit()
    n = conn.execute("SELECT COUNT(*) FROM findings WHERE topic_id = ?", (t["id"],)).fetchone()[0]
finally:
    conn.close()
print(json.dumps({"action": "resumed" if not t.get("enabled") else "already_tracking", "topic": topic, "history_findings": n}))
PYEOF
    )
    ;;

  drop)
    topic="${1:-}"
    [ -n "$topic" ] || { echo "usage: tracker drop \"<topic>\""; exit 2; }
    ( cd "$L30D" && "$PY" - "$topic" <<'PYEOF'
import sys, json, store
topic = sys.argv[1]
t = store.get_topic(topic)
if not t:
    print(json.dumps({"action": "not_found", "topic": topic})); sys.exit(0)
conn = store._connect()
try:
    conn.execute("UPDATE topics SET enabled = 0, updated_at = datetime('now') WHERE id = ?", (t["id"],))
    conn.commit()
    n = conn.execute("SELECT COUNT(*) FROM findings WHERE topic_id = ?", (t["id"],)).fetchone()[0]
finally:
    conn.close()
print(json.dumps({"action": "dropped", "topic": topic, "history_kept": n, "note": "say 'track <topic>' to resume with history intact"}))
PYEOF
    )
    ;;

  retune)
    topic="${1:-}"; queries="${2:-}"
    [ -n "$topic" ] && [ -n "$queries" ] || { echo "usage: tracker retune \"<topic>\" \"query one,query two\""; exit 2; }
    # Update the topic's search queries in place. Never remove+add: remove_topic deletes the
    # topic's findings, which would wipe history and every dismissal.
    ( cd "$L30D" && "$PY" - "$topic" "$queries" <<'PYEOF'
import sys, json, store
topic, raw = sys.argv[1], sys.argv[2]
queries = [q.strip() for q in raw.split(",") if q.strip()]
t = store.get_topic(topic)
if not t:
    store.add_topic(topic, search_queries=queries, schedule="0 8 * * *")
    print(json.dumps({"action": "added", "topic": topic, "queries": queries})); sys.exit(0)
conn = store._connect()
try:
    conn.execute("UPDATE topics SET search_queries = ? WHERE id = ?", (json.dumps(queries), t["id"]))
    conn.commit()
finally:
    conn.close()
print(json.dumps({"action": "retuned", "topic": topic, "queries": queries, "findings_kept": True}))
PYEOF
    )
    ;;

  dismiss)
    [ "$#" -ge 1 ] || { echo "usage: tracker dismiss <finding_id> [...]"; exit 2; }
    ( cd "$L30D" && "$PY" - "$@" <<'PYEOF'
import sys, store
n = 0
for arg in sys.argv[1:]:
    try:
        store.dismiss_finding(int(arg)); n += 1
    except Exception as e:
        print(f"could not dismiss {arg}: {e}")
print(f"dismissed {n} finding(s)")
PYEOF
    )
    ;;

  ingest)
    topic="${1:-}"; file="${2:-}"
    [ -n "$topic" ] && [ -f "$file" ] || { echo "usage: tracker ingest \"<topic>\" <file.json>  (JSON list of {title,url,source,author,text,engagement,published})"; exit 2; }
    ( cd "$L30D" && "$PY" - "$topic" "$file" <<'PYEOF'
import sys, json, store
topic, path = sys.argv[1], sys.argv[2]
items = json.load(open(path))
if isinstance(items, dict): items = items.get("items") or items.get("data") or []
t = store.get_topic(topic)
if not t:
    store.add_topic(topic, schedule="0 8 * * *"); t = store.get_topic(topic)
findings = []
for it in items:
    url = it.get("url") or it.get("source_url")
    if not url: continue
    findings.append({
        "source": it.get("source") or "x",
        "source_url": url,
        "source_title": (it.get("title") or (it.get("text") or "")[:120]),
        "author": it.get("author") or "",
        "content": it.get("text") or it.get("content") or "",
        "summary": it.get("summary") or "",
        "engagement_score": float(it.get("engagement") or it.get("engagement_score") or 0),
        "relevance_score": float(it.get("relevance") or 0),
        "published_at": it.get("published") or it.get("published_at"),
    })
run_id = store.record_run(t["id"], source_mode="agent-ingest", status="completed")
res = store.store_findings(run_id, t["id"], findings)
print(json.dumps({"topic": topic, "received": len(items), **res}))
PYEOF
    )
    ;;

  history)
    q="${1:-}"; lim="${2:-10}"
    [ -n "$q" ] || { echo "usage: tracker history \"<words>\" [limit]"; exit 2; }
    ( cd "$L30D" && "$PY" - "$q" "$lim" <<'PYEOF'
import sys, json, store
q, lim = sys.argv[1], int(sys.argv[2])
try:
    rows = store.search_findings(q, limit=lim)
except Exception as e:
    print(json.dumps({"query": q, "error": str(e), "matches": []})); sys.exit(0)
out = []
for r in rows:
    out.append({
        "id": r.get("id"), "topic": r.get("topic_name"), "title": (r.get("source_title") or "")[:120],
        "source": r.get("source"), "url": r.get("source_url"),
        "first_seen": r.get("first_seen"), "last_seen": r.get("last_seen"),
        "times_seen": r.get("sighting_count"), "dismissed": bool(r.get("dismissed")),
    })
print(json.dumps({"query": q, "matches": out}, indent=1, default=str))
PYEOF
    )
    ;;

  set-x-bearer)
    tok="${1:-}"
    [ -n "$tok" ] || { echo "usage: tracker set-x-bearer <x_api_bearer_token>"; exit 2; }
    [ "${#tok}" -ge 40 ] || { echo "that does not look like an X API bearer token (too short); nothing saved"; exit 2; }
    touch "$ENV_FILE"
    tmp="$(mktemp "$PROFILE/.env.XXXXXX")"
    grep -v '^X_BEARER_TOKEN=' "$ENV_FILE" > "$tmp" || true
    printf 'X_BEARER_TOKEN=%s\n' "$tok" >> "$tmp"
    mv "$tmp" "$ENV_FILE"; chmod 600 "$ENV_FILE"
    echo "saved: X_BEARER_TOKEN written to this agent's .env (ends ...${tok: -4})"
    ;;

  check-x-bearer)
    tok="$(read_x_bearer)"
    [ -n "$tok" ] || { echo "no key: X_BEARER_TOKEN is not set in $ENV_FILE"; exit 3; }
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -H "Authorization: Bearer $tok" \
      'https://api.x.com/2/tweets/search/recent?query=hermes%20agent%20-is%3Aretweet&max_results=10' || echo 000)"
    case "$code" in
      200) echo "ok: X API bearer works (HTTP 200)" ;;
      401) echo "invalid: X rejected the token (HTTP 401). Check it was copied in full."; exit 4 ;;
      402|403) echo "blocked: X returned HTTP $code. The developer app needs pay-per-use credit loaded and must sit inside a Project."; exit 4 ;;
      429) echo "ok-but-rate-limited: token accepted, X is rate limiting (HTTP 429). Try again in 15 minutes." ;;
      000) echo "unreachable: could not reach api.x.com (network?)"; exit 5 ;;
      *) echo "unexpected: HTTP $code from X"; exit 6 ;;
    esac
    ;;

  x-pull)
    topic="${1:-}"; maxr="${2:-50}"; hours="${3:-24}"
    [ -n "$topic" ] || { echo "usage: tracker x-pull \"<topic>\" [max_results 10-100] [hours]"; exit 2; }
    tok="$(read_x_bearer)"
    [ -n "$tok" ] || { echo '{"error": "no X_BEARER_TOKEN; run set-x-bearer first"}'; exit 3; }
    raw="$(mktemp "${TMPDIR:-/tmp}/x-raw.XXXXXX.json")"; items="$(mktemp "${TMPDIR:-/tmp}/x-items.XXXXXX.json")"
    # Build the query from the topic and its retune queries; the store knows both.
    q="$( cd "$L30D" && "$PY" - "$topic" <<'PYEOF'
import sys, json, store, urllib.parse
topic = sys.argv[1]
t = store.get_topic(topic) or {}
qs = []
try: qs = json.loads(t.get("search_queries") or "[]") or []
except Exception: qs = []
terms = [topic] + [q for q in qs if q and q.lower() != topic.lower()]
def quote(term): return f'"{term}"' if " " in term else term
core = " OR ".join(quote(x) for x in terms[:5])
query = f"({core}) -is:retweet lang:en"
print(urllib.parse.quote(query, safe=""))
PYEOF
)"
    start="$("$PY" -c "import datetime,sys; h=int(sys.argv[1]); print((datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(hours=h)).strftime('%Y-%m-%dT%H:%M:%SZ'))" "$hours")"
    if [ -n "${X_RAW_JSON_FILE:-}" ]; then cp "$X_RAW_JSON_FILE" "$raw"; code=200; else
      code="$(curl -s -o "$raw" -w '%{http_code}' --max-time 30 -H "Authorization: Bearer $tok" \
        "https://api.x.com/2/tweets/search/recent?query=${q}&max_results=${maxr}&start_time=${start}&sort_order=relevancy&tweet.fields=public_metrics,created_at,author_id&expansions=author_id&user.fields=username" || echo 000)"
    fi
    if [ "$code" != "200" ]; then echo "{\"error\": \"X returned HTTP $code\", \"topic\": \"$topic\"}"; rm -f "$raw" "$items"; exit 4; fi
    "$PY" - "$raw" "$items" <<'PYEOF'
import json, sys
raw, out = sys.argv[1], sys.argv[2]
d = json.load(open(raw))
users = {u["id"]: u.get("username", "") for u in (d.get("includes", {}) or {}).get("users", [])}
items = []
for t in d.get("data", []) or []:
    m = t.get("public_metrics", {}) or {}
    user = users.get(t.get("author_id"), "i")
    items.append({
        "title": (t.get("text") or "").replace("\n", " ")[:100],
        "url": f"https://x.com/{user}/status/{t['id']}",
        "source": "x",
        "author": f"@{user}" if user != "i" else "",
        "text": t.get("text") or "",
        "engagement": int(m.get("like_count", 0)) + 2 * int(m.get("retweet_count", 0)) + int(m.get("quote_count", 0)),
        "published": t.get("created_at"),
    })
json.dump(items, open(out, "w"))
print(json.dumps({"fetched": len(items), "reads_billed": len(items)}))
PYEOF
    bash "$0" ingest "$topic" "$items"
    rm -f "$raw" "$items"
    ;;

  set-x-key)
    key="${1:-}"
    case "$key" in
      xai-*) ;;
      "") echo "usage: tracker set-x-key <xai_api_key>"; exit 2 ;;
      *) echo "that does not look like an xAI key (they start with xai-); nothing saved"; exit 2 ;;
    esac
    # The research engine reads its own config file, not Hermes's .env.
    cfg_dir="$HOME/.config/last30days"; cfg="$cfg_dir/.env"
    mkdir -p "$cfg_dir"; touch "$cfg"
    tmp="$(mktemp "$cfg_dir/.env.XXXXXX")"
    grep -v '^XAI_API_KEY=' "$cfg" > "$tmp" || true
    printf 'XAI_API_KEY=%s\n' "$key" >> "$tmp"
    mv "$tmp" "$cfg"; chmod 600 "$cfg"
    echo "saved: XAI_API_KEY written to the research engine config (ends ...${key: -4})"
    ;;

  check-x-key)
    key="${XAI_API_KEY:-}"
    [ -n "$key" ] || key="$(sed -n 's/^XAI_API_KEY=//p' "$HOME/.config/last30days/.env" 2>/dev/null | tail -1 | tr -d '"'"'"' ')"
    [ -n "$key" ] || { echo "no key: XAI_API_KEY is not set"; exit 3; }
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -H "Authorization: Bearer $key" 'https://api.x.ai/v1/models' || echo 000)"
    case "$code" in
      200) echo "ok: xAI key works (HTTP 200)" ;;
      400|401|403) echo "invalid: xAI rejected the key (HTTP $code). Check it was copied in full."; exit 4 ;;
      000) echo "unreachable: could not reach api.x.ai (network?)"; exit 5 ;;
      *) echo "unexpected: HTTP $code from xAI"; exit 6 ;;
    esac
    ;;

  onboarding)
    action="${1:-status}"; task="${2:-}"; days="${3:-3}"
    # Reality checks, so the checklist can never contradict what is actually configured
    # (state file is new in 0.4.0; agents set up before it must not be asked again).
    has_topic=0; "$PY" "$L30D/watchlist.py" list 2>/dev/null | grep -q '"enabled": 1' && has_topic=1
    routines_on=0; jobs="$PROFILE/cron/jobs.json"
    if [ -f "$jobs" ]; then
      "$PY" - "$jobs" <<'PYEOF' && routines_on=1
import json, sys
d = json.load(open(sys.argv[1])); jobs = d.get("jobs", d) if isinstance(d, dict) else d
ok = any(j.get("id") == "news-tracker-daily" and j.get("enabled") for j in jobs)
sys.exit(0 if ok else 1)
PYEOF
    fi
    has_particle=0; [ -n "$(read_key)" ] && has_particle=1
    has_x=0; { [ -n "${XAI_API_KEY:-}" ] || grep -qs '^XAI_API_KEY=' "$HOME/.config/last30days/.env" || [ -n "$(read_x_bearer)" ]; } && has_x=1
    "$PY" - "$PROFILE/news-tracker.onboarding.json" "$action" "$task" "$days" "$has_topic" "$routines_on" "$has_particle" "$has_x" <<'PYEOF'
import sys, json, os, datetime
path, action, task, days = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
reality = dict(zip(["first_topic", "routines_on", "podcasts", "x_coverage"], [a == "1" for a in sys.argv[5:9]]))
TASKS = [
  ("first_topic",  "One topic confirmed after showing five results"),
  ("routines_on",  "Daily brief and weekly digest switched on, schedule stated"),
  ("podcasts",     "Podcast lane: Particle key connected, or declined"),
  ("x_coverage",   "X/Twitter coverage: xAI key connected, or declined"),
  ("room_ready",   "Told how to add it to a room and what it will post there"),
]
now = datetime.datetime.now(datetime.timezone.utc)
state = {}
if os.path.exists(path):
    try: state = json.load(open(path))
    except Exception: state = {}
tasks = state.setdefault("tasks", {})
for key, _ in TASKS:
    tasks.setdefault(key, {"status": "pending"})
# Reality wins: anything already configured is done, whatever the file says.
for key, done in reality.items():
    if done and tasks[key]["status"] != "done":
        tasks[key] = {"status": "done", "at": now.isoformat(), "detected": True}
def save():
    tmp = path + ".tmp"; json.dump(state, open(tmp, "w"), indent=1); os.replace(tmp, path)
if action in ("done", "skip", "later"):
    if task not in tasks: print(json.dumps({"error": f"unknown task {task}", "tasks": [k for k,_ in TASKS]})); sys.exit(2)
    t = tasks[task]
    if action == "done": t.update(status="done", at=now.isoformat())
    elif action == "skip": t.update(status="declined", at=now.isoformat())
    else: t.update(status="later", until=(now + datetime.timedelta(days=days)).isoformat(), at=now.isoformat())
    state["last_touch"] = now.isoformat()
save()
def is_due(t):
    if t["status"] == "pending": return True
    if t["status"] == "later":
        try: return datetime.datetime.fromisoformat(t["until"]) <= now
        except Exception: return True
    return False
pending = [k for k, _ in TASKS if is_due(tasks[k])]
nxt = pending[0] if pending else None
out = {
  "tasks": [{"task": k, "what": w, **tasks[k]} for k, w in TASKS],
  "next": nxt,
  "next_what": dict(TASKS).get(nxt) if nxt else None,
  "all_done": not any(is_due(tasks[k]) or tasks[k]["status"] == "later" for k, _ in TASKS),
}
if action == "next":
    print(json.dumps({"next": nxt, "what": out["next_what"], "all_done": out["all_done"]}))
else:
    print(json.dumps(out, indent=1))
PYEOF
    ;;

  timezone)
    tz="${1:-}"
    [ -n "$tz" ] || { echo "usage: tracker timezone <IANA zone, e.g. America/New_York>"; exit 2; }
    "$PY" -c "import sys, zoneinfo; zoneinfo.ZoneInfo(sys.argv[1])" "$tz" 2>/dev/null || { echo "invalid: '$tz' is not an IANA timezone (try Europe/London, America/New_York, Asia/Tokyo)"; exit 2; }
    bash "$0" config-set timezone "$tz" >/dev/null && echo "saved: timezone = $tz. Pause and resume the routines so their next run is recomputed in this zone."
    ;;

  config-set)
    key="${1:-}"; val="${2:-}"
    [ -n "$key" ] && [ -n "$val" ] || { echo "usage: tracker config-set <dotted.key> <value>"; exit 2; }
    # Needs PyYAML. Hermes's own venv always has it; the research Python may not.
    # Candidates: the Hermes venv next to the hermes binary, the documented install dirs, then anything else.
    HERMES_BIN="$(command -v hermes 2>/dev/null || true)"
    HERMES_REAL=""; [ -n "$HERMES_BIN" ] && HERMES_REAL="$(readlink -f "$HERMES_BIN" 2>/dev/null || true)"
    YPY=""
    for c in \
      "${HERMES_REAL:+$(dirname "$HERMES_REAL")/python}" \
      "${HERMES_REAL:+$(dirname "$(dirname "$HERMES_REAL")")/venv/bin/python}" \
      /usr/local/lib/hermes/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/venv/bin/python \
      "$HOME/.hermes/hermes-agent/venv/bin/python" "$PROFILE/hermes-agent/venv/bin/python" /opt/hermes/.venv/bin/python \
      "$PY" python3; do
      if [ -n "$c" ] && [ -x "$c" ] 2>/dev/null || { [ -n "$c" ] && command -v "$c" >/dev/null 2>&1; }; then
        if "$c" -c 'import yaml' >/dev/null 2>&1; then YPY="$c"; break; fi
      fi
    done
    [ -n "$YPY" ] || { echo "config-set: FAILED, no Python with PyYAML found; edit $PROFILE/config.yaml by hand: $key: $val"; exit 1; }
    "$YPY" - "$PROFILE/config.yaml" "$key" "$val" <<'PYEOF'
import sys, os, tempfile
path, key, raw = sys.argv[1], sys.argv[2], sys.argv[3]
import yaml
val = {"true": True, "false": False}.get(raw.lower(), raw)
if isinstance(val, str) and raw.strip().startswith(("[", "{")):
    import json as _json
    try: val = _json.loads(raw)
    except Exception: pass
elif isinstance(val, str):
    try: val = int(raw)
    except ValueError:
        try: val = float(raw)
        except ValueError: pass
cfg = {}
if os.path.exists(path):
    with open(path) as f: cfg = yaml.safe_load(f) or {}
node = cfg
parts = key.split(".")
for p in parts[:-1]:
    if not isinstance(node.get(p), dict): node[p] = {}
    node = node[p]
node[parts[-1]] = val
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".config.", suffix=".yaml")
with os.fdopen(fd, "w") as f: yaml.safe_dump(cfg, f, sort_keys=False)
os.replace(tmp, path)
print(f"set {key} = {val!r}")
PYEOF
    ;;

  reset)
    with_keys=0; [ "${1:-}" = "--keys" ] && with_keys=1
    ( cd "$L30D" && "$PY" - <<'PYEOF'
import json, store
names = [t["name"] for t in store.list_topics()]
for n in names:
    store.remove_topic(n)
print(json.dumps({"topics_removed": names}))
PYEOF
    )
    rm -f "$PROFILE/news-tracker.onboarding.json"
    jobs="$PROFILE/cron/jobs.json"
    if [ -f "$jobs" ]; then
      "$PY" - "$jobs" <<'PYEOF'
import json, sys, os, tempfile
p = sys.argv[1]; d = json.load(open(p)); jobs = d.get("jobs", []) if isinstance(d, dict) else d
n = 0
for j in jobs:
    if str(j.get("id", "")).startswith("news-tracker-"):
        j["enabled"] = False; j["state"] = "paused"; j["next_run_at"] = None
        j["paused_reason"] = "reset by tracker reset; setup re-enables"
        n += 1
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".jobs.", suffix=".json")
with os.fdopen(fd, "w") as f: json.dump(d if isinstance(d, dict) else {"jobs": jobs}, f, indent=2)
os.replace(tmp, p)
print(json.dumps({"routines_paused": n}))
PYEOF
    fi
    if [ "$with_keys" = 1 ]; then
      if [ -f "$ENV_FILE" ]; then
        tmp="$(mktemp "$PROFILE/.env.XXXXXX")"; grep -v '^PARTICLE_API_KEY=\|^X_BEARER_TOKEN=' "$ENV_FILE" > "$tmp" || true; mv "$tmp" "$ENV_FILE"; chmod 600 "$ENV_FILE"
        bash "$0" config-set "mcp_servers.particle.headers.X-API-Key" '${PARTICLE_API_KEY}' >/dev/null 2>&1 || true
      fi
      cfg="$HOME/.config/last30days/.env"
      if [ -f "$cfg" ]; then
        tmp="$(mktemp "$HOME/.config/last30days/.env.XXXXXX")"; grep -v '^XAI_API_KEY=' "$cfg" > "$tmp" || true; mv "$tmp" "$cfg"; chmod 600 "$cfg"
      fi
      echo '{"keys_removed": ["PARTICLE_API_KEY", "XAI_API_KEY"]}'
    fi
    echo "reset complete: the tracker is back to day zero. Start a fresh conversation (/new) to run onboarding again."
    ;;

  set-key)
    key="${1:-}"
    case "$key" in
      pp_*|pk_*) ;;
      "") echo "usage: tracker set-key <particle_api_key>"; exit 2 ;;
      *) echo "that does not look like a Particle key (they start with pp_ or pk_); nothing saved"; exit 2 ;;
    esac
    touch "$ENV_FILE"
    tmp="$(mktemp "$PROFILE/.env.XXXXXX")"
    grep -v '^PARTICLE_API_KEY=' "$ENV_FILE" > "$tmp" || true
    printf 'PARTICLE_API_KEY=%s\n' "$key" >> "$tmp"
    mv "$tmp" "$ENV_FILE"; chmod 600 "$ENV_FILE"
    # Also write the key straight into the MCP header. The ${PARTICLE_API_KEY} placeholder
    # depends on the running process having loaded .env and on the Hermes build supporting
    # interpolation; a literal header works everywhere and survives /reload-mcp.
    if bash "$0" config-set "mcp_servers.particle.headers.X-API-Key" "$key" >/dev/null 2>&1; then
      chmod 600 "$PROFILE/config.yaml" 2>/dev/null || true
      echo "saved: PARTICLE_API_KEY written to this agent's .env AND into the Particle MCP header (ends ...${key: -4}). The podcast tools connect on the next gateway restart."
    else
      echo "saved: PARTICLE_API_KEY written to this agent's .env (ends ...${key: -4}), but the MCP header could NOT be written (no Python with PyYAML). Podcasts will only work if the host resolves \${PARTICLE_API_KEY} in config.yaml."
    fi
    ;;

  podcast-link)
    slug="${1:-}"; at="${2:-}"; pslug="${3:-}"; etitle="${4:-}"
    [ -n "$slug" ] || { echo "usage: tracker podcast-link <episode_slug> [start_seconds] [podcast_slug] [episode_title]"; exit 2; }
    key="$(read_key)"; [ -n "$key" ] || { echo '{"error": "no PARTICLE_API_KEY"}'; exit 3; }
    raw="$(mktemp "${TMPDIR:-/tmp}/ep.XXXXXX.json")"
    code="$(curl -s -o "$raw" -w '%{http_code}' --max-time 20 -H "X-API-Key: $key" "https://api.particle.pro/v1/podcasts/episodes/$slug" || echo 000)"
    if [ "$code" != "200" ] && [ -n "$pslug" ]; then
      # Fallback: the slug did not resolve; find the episode by title inside the podcast's recent episodes.
      list="$(mktemp "${TMPDIR:-/tmp}/eps.XXXXXX.json")"
      lcode="$(curl -s -o "$list" -w '%{http_code}' --max-time 20 -H "X-API-Key: $key" "https://api.particle.pro/v1/podcasts/$pslug/episodes?limit=50" || echo 000)"
      if [ "$lcode" = "200" ]; then
        best="$("$PY" - "$list" "$slug" "$etitle" <<'PYEOF'
import json, sys, difflib
d = json.load(open(sys.argv[1])); eps = d.get("data", []); want_slug, want_title = sys.argv[2], sys.argv[3]
def score(e):
    s1 = difflib.SequenceMatcher(None, want_slug, e.get("slug","")).ratio()
    s2 = difflib.SequenceMatcher(None, want_title.lower(), (e.get("title") or "").lower()).ratio() if want_title else 0
    return max(s1, s2)
if eps:
    e = max(eps, key=score)
    print(e["slug"] if score(e) >= 0.6 else "")
PYEOF
)"
        if [ -n "$best" ]; then
          code="$(curl -s -o "$raw" -w '%{http_code}' --max-time 20 -H "X-API-Key: $key" "https://api.particle.pro/v1/podcasts/episodes/$best" || echo 000)"
        fi
      fi
      rm -f "$list"
    fi
    if [ "$code" != "200" ]; then echo "{\"link\": null, \"note\": \"no public link\", \"error\": \"could not resolve episode $slug (HTTP $code)\"}"; rm -f "$raw"; exit 0; fi
    "$PY" - "$raw" "$at" <<'PYEOF'
import json, sys
d = json.load(open(sys.argv[1])); e = d.get("data", d); at = sys.argv[2]
try: t = int(float(at)) if at else None
except ValueError: t = None
videos = e.get("videos") or []
yt = next((v.get("url") for v in videos if v.get("platform") == "youtube" and v.get("url")), None)
best, label = None, None
if yt:
    best = yt + (f"&t={t}s" if t is not None and "?" in yt else (f"?t={t}s" if t is not None else "")); label = "YouTube"
elif e.get("url"):
    best, label = e["url"], "episode audio"
pod = e.get("podcast") or {}
out = {
  "show": pod.get("title"), "episode": e.get("title"), "published": e.get("published_at"),
  "link": best, "link_label": label, "youtube": yt, "publisher_url": e.get("url"),
  "start_seconds": t, "resolved_slug": e.get("slug"), "note": None if best else "no public link"
}
print(json.dumps(out))
PYEOF
    rm -f "$raw"
    ;;

  sync-header)
    key="$(read_key)"
    [ -n "$key" ] || { echo "no key: PARTICLE_API_KEY is not set in $ENV_FILE"; exit 3; }
    if bash "$0" config-set "mcp_servers.particle.headers.X-API-Key" "$key" >/dev/null 2>&1; then
      chmod 600 "$PROFILE/config.yaml" 2>/dev/null || true
      echo "synced: Particle MCP header now holds the stored key (ends ...${key: -4}). It takes effect at the next gateway restart or /reload-mcp."
    else
      echo "FAILED: could not write config.yaml (no Python with PyYAML found)"; exit 1
    fi
    ;;

  header-state)
    line="$(grep -n 'X-API-Key' "$PROFILE/config.yaml" 2>/dev/null | head -1)"
    case "$line" in
      "") echo "header: missing (no Particle MCP header in config.yaml)";;
      *'${PARTICLE_API_KEY}'*) echo "header: placeholder (\${PARTICLE_API_KEY}); relies on the host resolving env vars";;
      *pp_*|*pk_*) echo "header: literal key present (ends ...$(printf '%s' "$line" | sed -n 's/.*\(....\)$/\1/p'))";;
      *) echo "header: set to an unexpected value";;
    esac
    ;;

  check-key)
    key="$(read_key)"
    [ -n "$key" ] || { echo "no key: PARTICLE_API_KEY is not set in $ENV_FILE"; exit 3; }
    # /v1/entities/search is the documented lookup; the quickstart's /v1/entities?q= returns 422.
    # Only 401/403 mean a bad key. Any other 4xx means the key was accepted and the request shape
    # was not, which still proves the key.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -H "X-API-Key: $key" \
      'https://api.particle.pro/v1/entities/search?q=altman&limit=1' || echo 000)"
    case "$code" in
      200) echo "ok: Particle key works (HTTP 200)" ;;
      401|403) echo "invalid: Particle rejected the key (HTTP $code). Check it was copied in full."; exit 4 ;;
      000) echo "unreachable: could not reach api.particle.pro (network?)"; exit 5 ;;
      4*) echo "ok: Particle accepted the key (HTTP $code on a probe request; auth passed)" ;;
      *) echo "unexpected: HTTP $code from Particle"; exit 6 ;;
    esac
    ;;

  *) echo "usage: tracker watchlist|briefing|research|track|drop|retune|dismiss|history|ingest|podcast-link|set-key|check-key|sync-header|header-state|set-x-bearer|check-x-bearer|x-pull|set-x-key|check-x-key|onboarding|timezone|config-set|reset ..."; exit 2 ;;
esac
